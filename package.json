{
  "name": "drew-baker-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "posttypecheck": "node scripts/clean-generated-next-env.mjs",
    "lint": "eslint .",
    "verify:media": "node scripts/verify-media-manifests.mjs",
    "verify:origin": "node --experimental-strip-types scripts/verify-site-origin.mjs",
    "verify:public-scope": "node scripts/verify-public-candidate.mjs",
    "check": "npm run typecheck && npm run lint && npm run verify:media && npm run verify:origin && npm run verify:public-scope && npm run build",
    "postbuild": "node scripts/clean-generated-next-env.mjs",
    "test:site": "playwright test",
    "verify": "npm run check && npm run test:site",
    "verify:release-candidate": "node scripts/verify-release-candidate.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.4",
    "typescript": "6.0.3"
  }
}
